# Local: copy to .env (everything optional except an AI key).
# Railway: set these as service Variables. Most API keys can instead be entered by the admin on the Settings page.

# ---- Accounts ----
ADMIN_EMAIL=             # this email becomes admin when it signs up (otherwise: the first account created)

# ---- Database (Railway: reference your Postgres service) ----
DATABASE_URL=            # e.g. ${{Postgres.DATABASE_URL}} on Railway. Blank = local SQLite file.

# ---- Video storage: Railway Bucket / Cloudflare R2 / any S3 (blank = local folder) ----
# Railway Bucket variable names are read directly: ENDPOINT, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION
# or use the S3_* names:
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ADDRESSING_STYLE=     # virtual (default) or path

# ---- Script writing (at least one). Gemini first, Groq fallback ----
GEMINI_API_KEY=          # https://aistudio.google.com -> Get API key
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/settings/keys (free :free models; DeepSeek preferred when free)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys (starter credit, then pay-as-you-go)
LLM_ORDER=               # e.g. gemini,groq,openrouter,deepseek (blank = that order)

# ---- Stock footage ----
PIXABAY_API_KEY=         # https://pixabay.com/api/docs/ (shown when logged in)
PEXELS_API_KEY=          # https://www.pexels.com/api/ (new keys currently paused)

# ---- AI images: Cloudflare Workers AI (~50 FLUX images/day free) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=    # token with Account > Workers AI > Edit, your account included

# ---- Social apps (see DEPLOY.md) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Running a second copy (e.g. your PC) against the production database? ----
BACKGROUND_TASKS=        # set to false there, so only Railway runs the scheduler

# ---- Site ----
PUBLIC_URL=              # e.g. https://faceless.up.railway.app
CONTACT_EMAIL=
ALLOW_SIGNUP=true
DAILY_VIDEO_LIMIT=3      # per user per 24h (0 = unlimited; admins unlimited)
KEEP_VIDEOS_DAYS=0       # delete video files after N days (0 = keep forever)
